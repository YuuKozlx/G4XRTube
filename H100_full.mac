# Reproducible H-100 production run (100 kVp).

/run/numberOfThreads 8

# Geometry
/XRtube/det/setTargetMaterial G4_W
/XRtube/det/setAnodeAngle 15 deg

# Inherent filtration
/XRtube/det/setInherentFilterMaterial G4_Al
/XRtube/det/setInherentFilterThickness 4 mm

# Additional filtration
/XRtube/det/setFilterMaterial G4_Cu
/XRtube/det/setFilterThickness 0.15 mm

# Electromagnetic physics and production cut
/phys/SelectPhysicsList standard_option4
/phys/setCuts 5. um

/run/initialize

# Bremsstrahlung splitting
/process/em/setSecBiasing eBrem world 200 1000 keV

/control/verbose 1
/run/verbose 1
/xraytube/setEnergy 100 keV
/run/initialize

/random/setSeeds 1234567 7654321
/run/beamOn 5000000
